{
  "create_event": {
    "endpoint": "POST /events",
    "body": {
      "name": "Fergusson Fest 2026",
      "college": "Fergusson College, Pune",
      "event_date": "2026-12-12",
      "expected_footfall": 1800,
      "audience": "18-22 year old arts, science and commerce students; many live in nearby PGs and hostels",
      "budget_goal_inr": 120000,
      "lat": 18.5236,
      "lng": 73.8394
    }
  },
  "approve_shortlist": {
    "endpoint": "POST /runs/{run_id}/approve",
    "body": {
      "gate": "shortlist",
      "decision": "approve",
      "edits": { "selected_brand_ids": ["osm-3f2a9c1b7d", "osm-8b11e0c2aa", "osm-c94d02f513"] }
    }
  },
  "reject_shortlist_with_feedback": {
    "endpoint": "POST /runs/{run_id}/approve",
    "body": {
      "gate": "shortlist",
      "decision": "reject",
      "edits": { "feedback": "We already have a cafe sponsor; look for coaching centres and gyms instead." }
    }
  },
  "approve_send_with_edits": {
    "endpoint": "POST /runs/{run_id}/approve",
    "body": {
      "gate": "send",
      "decision": "approve",
      "edits": {
        "exclude": ["osm-c94d02f513"],
        "emails": { "osm-3f2a9c1b7d": { "subject": "Fergusson Fest x your cafe", "body": "Hi! ..." } }
      }
    }
  },
  "poll_replies": { "endpoint": "POST /runs/{run_id}/poll-replies", "body": null },
  "add_evidence_link": {
    "endpoint": "POST /runs/{run_id}/evidence (multipart/form-data)",
    "form": { "brand_id": "osm-3f2a9c1b7d", "link": "https://www.instagram.com/p/EXAMPLE/", "note": "1 Instagram post" }
  },
  "add_evidence_photo": {
    "endpoint": "POST /runs/{run_id}/evidence (multipart/form-data)",
    "form": { "brand_id": "osm-3f2a9c1b7d", "file": "stage.jpg (image/jpeg, <= 8 MB)", "note": "Logo on main stage banner" }
  },
  "run_audit": { "endpoint": "POST /runs/{run_id}/audit", "body": null },
  "publish_report": {
    "endpoint": "POST /runs/{run_id}/approve",
    "body": { "gate": "roi_publish", "decision": "approve", "edits": { "note": "Stall photos were lost; disclosed." } }
  }
}
