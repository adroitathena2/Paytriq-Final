# Copy to frontend/.env.local. These values are public (they ship to the browser).
VITE_API_URL=http://localhost:8000
# Supabase project URL and anon (public) key. Leave both empty for local dev with AUTH_DISABLED=true on the backend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
