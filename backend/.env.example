# Copy to backend/.env and fill in. Never commit the real .env. See README "Environment variables".

# --- LLM (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key
# Any current Flash model; the alias always points to the latest one.
GEMINI_MODEL=gemini-flash-latest
# Minimum seconds between LLM calls (raise to ~4 on the free tier to avoid 429s).
GEMINI_MIN_INTERVAL_S=0

# --- Supabase (Project Settings -> API / Database) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only for projects that still use the legacy HS256 JWT secret; leave empty to use the JWKS endpoint.
SUPABASE_JWT_SECRET=
# Session pooler connection string (IPv4), e.g. postgresql://postgres.ref:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Leave empty locally to use the in-memory database and checkpointer.
DATABASE_URL=

# Local development only: skip login and use a fixed dev user. Never true in deployment.
AUTH_DISABLED=false

# --- Discovery (optional; without it the free OpenStreetMap Overpass API is used) ---
GOOGLE_MAPS_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Gmail (OAuth client + refresh token for the dedicated demo sender account) ---
GMAIL_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_SENDER=paytriq.demo@gmail.com

# --- Demo / safety ---
# When true, every outgoing email goes to DEMO_RECIPIENTS instead of the real business.
DEMO_MODE=true
DEMO_RECIPIENTS=teammate1@example.com,teammate2@example.com
NUDGE_AFTER_DAYS=3

# --- Web ---
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
